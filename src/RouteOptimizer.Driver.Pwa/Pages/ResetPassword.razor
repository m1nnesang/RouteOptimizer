@page "/reset-password"
@layout MinimalLayout
@using System.ComponentModel.DataAnnotations
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Set new password</PageTitle>

<section class="login">
    <header class="login__head">
        <h1 class="login__title">Route</h1>
        <p class="login__subtitle">Set a new password</p>
    </header>

    <EditForm class="login__form" Model="_model" OnValidSubmit="HandleSubmitAsync">
        <DataAnnotationsValidator />

        <div class="field">
            <label class="field__label" for="token">Reset token</label>
            <InputText id="token" class="field__input" @bind-Value="_model.Token" />
            <ValidationMessage For="() => _model.Token" />
        </div>

        <div class="field">
            <label class="field__label" for="password">New password</label>
            <InputText id="password" type="password" class="field__input" @bind-Value="_model.NewPassword"
                       autocomplete="new-password" />
            <ValidationMessage For="() => _model.NewPassword" />
        </div>

        @if (_error is not null)
        {
            <p class="login__error" role="alert">@_error</p>
        }

        <button type="submit" class="btn btn--primary" disabled="@_busy">
            @(_busy ? "Saving…" : "Set new password")
        </button>
    </EditForm>

    <p class="login__links">
        <a href="login">Back to sign in</a>
    </p>
</section>

@code {
    private readonly ResetModel _model = new();
    private bool _busy;
    private string? _error;

    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(Token))
            _model.Token = Token;
    }

    private async Task HandleSubmitAsync()
    {
        _busy = true;
        _error = null;

        var ok = await AuthService.ResetPasswordAsync(_model.Token, _model.NewPassword);
        _busy = false;

        if (!ok)
        {
            _error = "Invalid or expired reset token.";
            return;
        }

        Navigation.NavigateTo("login");
    }

    private sealed class ResetModel
    {
        [Required(ErrorMessage = "Token is required")]
        public string Token { get; set; } = string.Empty;

        [Required(ErrorMessage = "Password is required")]
        [MinLength(8, ErrorMessage = "Password must be at least 8 characters")]
        public string NewPassword { get; set; } = string.Empty;
    }
}
