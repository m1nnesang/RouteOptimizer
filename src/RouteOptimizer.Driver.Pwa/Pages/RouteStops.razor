@page "/routes/{RouteId:guid}"
@attribute [Authorize]
@implements IAsyncDisposable
@inject IRouteApi RouteApi
@inject IGeolocation Geolocation
@inject IJSRuntime JS
@inject IConnectivity Connectivity
@inject IOutboxFlusher Outbox
@inject IRouteHubClient Hub

<PageTitle>Маршрут</PageTitle>

@if (_loading)
{
    <section class="screen">
        <p class="screen__hint">Загрузка…</p>
    </section>
}
else if (_error || _route is null)
{
    <section class="screen">
        <a class="back-link" href="">← Маршруты</a>
        <p class="screen__hint">Не удалось загрузить маршрут.</p>
        <button class="btn btn--secondary" @onclick="LoadAsync">Повторить</button>
    </section>
}
else
{
    <div class="nav-screen">
        <RouteMap @ref="_map" Stops="_route.Stops" CurrentStopId="_currentStopId" />

        <div class="topbar">
            <a class="topbar__btn" href="">←</a>
            <span class="badge @StatusLabels.Css(_route.Status)">@StatusLabels.Route(_route.Status)</span>
            <button class="topbar__btn" @onclick="OpenList">Список</button>
        </div>

        @if (!_isOnline || _pendingCount > 0)
        {
            <div class="net-banner @(_isOnline ? "net-banner--sync" : "net-banner--offline")">
                @if (!_isOnline)
                {
                    <span>Нет сети — работаем офлайн</span>
                }
                @if (_pendingCount > 0)
                {
                    <span>· @_pendingCount в очереди</span>
                }
            </div>
        }

        @if (_actionError is not null)
        {
            <p class="action-error nav-screen__error">@_actionError</p>
        }

        <div class="nav-screen__bottom">
            @if (_route.Status == "Assigned")
            {
                <button class="btn btn--primary" disabled="@_busy" @onclick="StartRouteAsync">Начать маршрут</button>
            }
            else if (_route.Stops.Count == 0)
            {
                <p class="screen__hint nav-screen__empty">В этом маршруте нет остановок.</p>
            }
            else
            {
                <div class="stop-slider" id="stop-slider">
                    @foreach (var stop in _route.Stops.OrderBy(s => s.Sequence))
                    {
                        <div class="stop-slide" data-stop-id="@stop.Id">
                            <StopCard Stop="stop" RouteId="RouteId"
                                      RouteInProgress="@(_route.Status == "InProgress")"
                                      OnChanged="ReloadAsync" />
                        </div>
                    }
                </div>

                @if (_route.Status == "InProgress" && AllStopsClosed)
                {
                    <button class="btn btn--secondary nav-screen__finish" disabled="@_busy" @onclick="CompleteRouteAsync">
                        Завершить маршрут
                    </button>
                }
            }
        </div>

        <StopListDrawer Open="_listOpen" Stops="_route.Stops" CurrentStopId="_currentStopId"
                        OnSelect="SelectStop" OnClose="CloseList" />
    </div>
}

@code {
    [Parameter]
    public Guid RouteId { get; set; }

    private RouteDetail? _route;
    private RouteMap? _map;
    private DotNetObjectReference<RouteStops>? _dotNetRef;

    private bool _loading = true;
    private bool _error;
    private bool _busy;
    private string? _actionError;
    private bool _listOpen;

    private Guid? _currentStopId;
    private bool _sliderInitNeeded;
    private bool _servicesInitialized;

    private bool _isOnline = true;
    private int _pendingCount;

    private CancellationTokenSource? _gpsCts;
    private bool _gpsRunning;

    private bool AllStopsClosed =>
        _route is not null && _route.Stops.All(s => s.Status is not ("Pending" or "InProgress"));

    protected override void OnInitialized() => _dotNetRef = DotNetObjectReference.Create(this);

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = false;
        _actionError = null;

        try
        {
            _route = await RouteApi.GetRouteAsync(RouteId);
            UpdateCurrentStop();
        }
        catch (HttpRequestException)
        {
            _error = true;
        }
        finally
        {
            _loading = false;
        }

        _sliderInitNeeded = _route is not null && !_error;
        SyncGpsLoop();
    }

    private async Task ReloadAsync()
    {
        try
        {
            _route = await RouteApi.GetRouteAsync(RouteId);
            UpdateCurrentStop();
        }
        catch (HttpRequestException)
        {
            _actionError = "Нет связи с сервером.";
            return;
        }

        _sliderInitNeeded = true;
        SyncGpsLoop();
        await RefreshPendingAsync();
    }

    private void UpdateCurrentStop()
    {
        if (_route is null)
        {
            _currentStopId = null;
            return;
        }

        var current = _route.Stops.FirstOrDefault(s => s.Status == "InProgress")
                      ?? _route.Stops.OrderBy(s => s.Sequence).FirstOrDefault(s => s.Status == "Pending");

        _currentStopId = current?.Id;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_servicesInitialized)
        {
            _servicesInitialized = true;
            await InitServicesAsync();
        }

        if (_route is null || _error || !_sliderInitNeeded)
            return;

        _sliderInitNeeded = false;

        await JS.InvokeVoidAsync("driverSlider.observe", "stop-slider", _dotNetRef);

        if (_currentStopId is not null)
            await JS.InvokeVoidAsync("driverSlider.scrollTo", "stop-slider", _currentStopId);
    }

    [JSInvokable]
    public async Task OnStopFocused(string stopId)
    {
        if (_route is null || !Guid.TryParse(stopId, out var id))
            return;

        var stop = _route.Stops.FirstOrDefault(s => s.Id == id);

        if (stop is not null && _map is not null)
            await _map.FocusStopAsync(stop);
    }

    private async Task InitServicesAsync()
    {
        await Connectivity.InitializeAsync();
        _isOnline = Connectivity.IsOnline;
        Connectivity.Changed += OnConnectivityChangedAsync;

        await RefreshPendingAsync();

        if (_isOnline)
            await FlushAndReloadAsync();

        if (_route is not null)
            await Hub.ConnectAsync(RouteId, OnRouteChangedAsync);
    }

    private async Task OnConnectivityChangedAsync(bool isOnline)
    {
        _isOnline = isOnline;

        if (isOnline)
            await FlushAndReloadAsync();

        await InvokeAsync(StateHasChanged);
    }

    private async Task OnRouteChangedAsync() => await InvokeAsync(ReloadAsync);

    private async Task FlushAndReloadAsync()
    {
        _pendingCount = await Outbox.FlushAsync();
        await ReloadAsync();
    }

    private async Task RefreshPendingAsync()
    {
        _pendingCount = await Outbox.PendingCountAsync();
        _isOnline = Connectivity.IsOnline;
    }

    private void OpenList() => _listOpen = true;

    private void CloseList() => _listOpen = false;

    private async Task SelectStop(RouteStop stop)
    {
        _listOpen = false;
        await JS.InvokeVoidAsync("driverSlider.scrollTo", "stop-slider", stop.Id);

        if (_map is not null)
            await _map.FocusStopAsync(stop);
    }

    private async Task StartRouteAsync()
    {
        await RunActionAsync(() => RouteApi.StartRouteAsync(RouteId));
        await PingLocationAsync();
    }

    private Task CompleteRouteAsync() => RunActionAsync(() => RouteApi.CompleteRouteAsync(RouteId));

    private async Task RunActionAsync(Func<Task<ApiResult>> action)
    {
        if (_busy)
            return;

        _busy = true;
        _actionError = null;

        try
        {
            var result = await action();

            if (result.Success)
                await ReloadAsync();
            else
                _actionError = result.Error;
        }
        catch (HttpRequestException)
        {
            _actionError = "Нет связи с сервером.";
        }
        finally
        {
            _busy = false;
        }
    }

    private void SyncGpsLoop()
    {
        if (_route?.Status == "InProgress")
            StartGpsLoop();
        else
            StopGpsLoop();
    }

    private void StartGpsLoop()
    {
        if (_gpsRunning)
            return;

        _gpsRunning = true;
        _gpsCts = new CancellationTokenSource();
        _ = GpsLoopAsync(_gpsCts.Token);
    }

    private void StopGpsLoop()
    {
        if (!_gpsRunning)
            return;

        _gpsRunning = false;
        _gpsCts?.Cancel();
        _gpsCts?.Dispose();
        _gpsCts = null;
    }

    private async Task GpsLoopAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(30));

        try
        {
            while (await timer.WaitForNextTickAsync(ct))
                await PingLocationAsync();
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task PingLocationAsync()
    {
        var position = await Geolocation.TryGetCurrentPositionAsync();

        if (position is null)
            return;

        if (_map is not null)
            await _map.SetDriverAsync(position.Latitude, position.Longitude);

        try
        {
            await RouteApi.PushLocationAsync(RouteId, position.Latitude, position.Longitude);
        }
        catch (HttpRequestException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        StopGpsLoop();
        Connectivity.Changed -= OnConnectivityChangedAsync;

        try
        {
            await Hub.StopAsync();
        }
        catch (Exception)
        {
        }

        try
        {
            await JS.InvokeVoidAsync("driverSlider.dispose", "stop-slider");
        }
        catch (Exception)
        {
        }

        _dotNetRef?.Dispose();
    }
}
