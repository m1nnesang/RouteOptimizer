@page "/login"
@layout MinimalLayout
@inject IAuthService AuthService
@inject JwtAuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Sign in</PageTitle>

<section class="login">
    <header class="login__head">
        <h1 class="login__title">Route</h1>
        <p class="login__subtitle">Driver sign-in</p>
    </header>

    <EditForm class="login__form" Model="_model" OnValidSubmit="HandleLoginAsync">
        <DataAnnotationsValidator />

        <div class="field">
            <label class="field__label" for="email">Email</label>
            <InputText id="email" class="field__input" @bind-Value="_model.Email"
                       autocomplete="username" inputmode="email" />
            <ValidationMessage For="() => _model.Email" />
        </div>

        <div class="field">
            <label class="field__label" for="password">Password</label>
            <InputText id="password" type="password" class="field__input" @bind-Value="_model.Password"
                       autocomplete="current-password" />
            <ValidationMessage For="() => _model.Password" />
        </div>

        @if (_error is not null)
        {
            <p class="login__error" role="alert">@_error</p>
        }

        <button type="submit" class="btn btn--primary" disabled="@_busy">
            @(_busy ? "Signing in…" : "Sign in")
        </button>
    </EditForm>

    <p class="login__links">
        <a href="forgot-password">Forgot password?</a>
    </p>
</section>

@code {
    private readonly LoginModel _model = new();
    private bool _busy;
    private string? _error;

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private async Task HandleLoginAsync()
    {
        _busy = true;
        _error = null;

        var outcome = await AuthService.LoginAsync(_model.Email, _model.Password);
        _busy = false;

        if (outcome != LoginOutcome.Success)
        {
            _error = ErrorFor(outcome);
            return;
        }

        AuthStateProvider.NotifyUserAuthentication();

        var target = string.IsNullOrEmpty(ReturnUrl) ? string.Empty : Uri.UnescapeDataString(ReturnUrl);
        Navigation.NavigateTo(target);
    }

    private static string ErrorFor(LoginOutcome outcome) => outcome switch
    {
        LoginOutcome.RateLimited => "Too many attempts. Try again later.",
        LoginOutcome.NetworkError => "No server connection. Check your network.",
        LoginOutcome.ServerError => "Server error. Try again later.",
        _ => "Invalid email or password"
    };

    private sealed class LoginModel
    {
        [Required(ErrorMessage = "Email is required")]
        [EmailAddress(ErrorMessage = "Invalid email")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Password is required")]
        public string Password { get; set; } = string.Empty;
    }
}
