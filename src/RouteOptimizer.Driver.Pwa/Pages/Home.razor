@page "/"
@attribute [Authorize]
@inject IRouteApi RouteApi
@inject NavigationManager Navigation

<PageTitle>Route</PageTitle>

<section class="screen">
    <div class="screen__head">
        <h1 class="screen__title">@(_isToday ? "Today's route" : _selectedDate.ToString("dd.MM.yyyy"))</h1>
        <input class="screen__date" type="date" max="@_today.ToString("yyyy-MM-dd")"
               value="@_selectedDate.ToString("yyyy-MM-dd")" @onchange="OnDateChanged" />
    </div>

    @if (_loading)
    {
        <p class="screen__hint">Loading…</p>
    }
    else if (_error)
    {
        <p class="screen__hint">Failed to load route.</p>
        <button class="btn btn--secondary" @onclick="LoadAsync">Retry</button>
    }
    else if (_routes.Count == 0)
    {
        <p class="screen__hint">@(_isToday ? "No routes for today. Start your shift with the dispatcher." : "No routes for this date.")</p>
    }
    else
    {
        <div class="route-list">
            @foreach (var route in _routes)
            {
                <button class="route-card" @onclick="() => OpenRoute(route.Id)">
                    <div class="route-card__head">
                        <span class="route-card__title">@route.WarehouseName</span>
                        <span class="badge @StatusLabels.Css(route.Status)">@StatusLabels.Route(route.Status)</span>
                    </div>
                    <div class="route-card__meta">
                        <span>Stops: @route.StopsCount</span>
                        @if (route.Date is { } date)
                        {
                            <span>@date.ToString("dd.MM.yyyy")</span>
                        }
                    </div>
                </button>
            }
        </div>
    }
</section>

@code {
    private IReadOnlyList<RouteListItem> _routes = [];
    private bool _loading = true;
    private bool _error;

    private readonly DateOnly _today = DateOnly.FromDateTime(DateTime.Now);
    private DateOnly _selectedDate = DateOnly.FromDateTime(DateTime.Now);

    private bool _isToday => _selectedDate == _today;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task OnDateChanged(ChangeEventArgs e)
    {
        if (DateOnly.TryParse(e.Value?.ToString(), out var picked))
        {
            _selectedDate = picked;
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = false;

        try
        {
            _routes = await RouteApi.GetMyRoutesAsync(_isToday ? null : _selectedDate);
        }
        catch (HttpRequestException)
        {
            _error = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private void OpenRoute(Guid id) => Navigation.NavigateTo($"routes/{id}");
}
