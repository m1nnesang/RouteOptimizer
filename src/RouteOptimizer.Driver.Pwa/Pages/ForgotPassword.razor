@page "/forgot-password"
@layout MinimalLayout
@using System.ComponentModel.DataAnnotations
@inject IAuthService AuthService

<PageTitle>Forgot password</PageTitle>

<section class="login">
    <header class="login__head">
        <h1 class="login__title">Route</h1>
        <p class="login__subtitle">Reset your password</p>
    </header>

    <EditForm class="login__form" Model="_model" OnValidSubmit="HandleSubmitAsync">
        <DataAnnotationsValidator />

        <div class="field">
            <label class="field__label" for="email">Email</label>
            <InputText id="email" class="field__input" @bind-Value="_model.Email"
                       autocomplete="username" inputmode="email" />
            <ValidationMessage For="() => _model.Email" />
        </div>

        @if (_message is not null)
        {
            <p class="login__info" role="status">@_message</p>
        }

        <button type="submit" class="btn btn--primary" disabled="@_busy">
            @(_busy ? "Sending…" : "Send reset link")
        </button>
    </EditForm>

    <p class="login__links">
        <a href="login">Back to sign in</a>
    </p>
</section>

@code {
    private readonly ForgotModel _model = new();
    private bool _busy;
    private string? _message;

    private async Task HandleSubmitAsync()
    {
        _busy = true;
        _message = null;

        await AuthService.RequestPasswordResetAsync(_model.Email);

        _busy = false;
        _message = "If the email exists, a reset link has been sent.";
    }

    private sealed class ForgotModel
    {
        [Required(ErrorMessage = "Email is required")]
        [EmailAddress(ErrorMessage = "Invalid email")]
        public string Email { get; set; } = string.Empty;
    }
}
