@inject IRouteApi RouteApi
@inject IGeolocation Geolocation
@inject IConnectivity Connectivity

<div class="stop-card">
    <div class="stop-card__head">
        <div class="stop-card__head-left">
            <div class="pin stop-card__seq @PinClass">@(Stop.Sequence + 1)</div>
            <div>
                <div class="stop-card__eyebrow @(IsCurrent ? "" : "stop-card__eyebrow--muted")">@Eyebrow</div>
                <div class="stop-card__counter">Stop @(Stop.Sequence + 1) of @TotalStops</div>
            </div>
        </div>
        <a class="navigate-btn"
           href="https://www.google.com/maps/dir/?api=1&destination=@Stop.Latitude,@Stop.Longitude"
           target="_blank" rel="noopener">
            <svg width="15" height="15" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M8 1.5l5.5 12-5.5-3-5.5 3z" fill="currentColor" />
            </svg>
            Navigate
        </a>
    </div>

    <div class="stop-card__address">@Stop.Street</div>
    <div class="stop-card__city">@Stop.City</div>

    @if (_error is not null)
    {
        <p class="action-error">@_error</p>
    }

    <ul class="order-list">
        @foreach (var order in Stop.Orders)
        {
            <li class="order-row @OrderRowCss(order.Status)">
                <div class="order-row__main">
                    <div class="order-row__avatar">@Initials(order.Recipient)</div>
                    <div class="order-row__info">
                        <span class="order-row__recipient">
                            @order.Recipient
                            @if (!string.IsNullOrWhiteSpace(order.Apartment))
                            {
                                <span class="order-row__apartment">apt. @order.Apartment</span>
                            }
                        </span>
                        @if (!string.IsNullOrWhiteSpace(order.Phone))
                        {
                            <a class="order-row__phone" href="tel:@order.Phone">@order.Phone</a>
                        }
                    </div>

                    @if (IsOrderClosed(order.Status))
                    {
                        <span class="badge @StatusLabels.OrderCss(order.Status)">@StatusLabels.Order(order.Status)</span>
                    }
                </div>

                @if (!IsOrderClosed(order.Status) && CanAct && _failOrderId != order.OrderId)
                {
                    <div class="order-row__actions">
                        <button class="btn btn--success btn--sm" disabled="@_busy"
                                @onclick="() => DeliverAsync(order.OrderId)">
                            <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                                <path d="M4 10.5l4 4 8-9" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                            Delivered
                        </button>
                        <button class="btn btn--danger btn--sm" disabled="@_busy"
                                @onclick="() => OpenFailForm(order.OrderId)">Not delivered</button>
                    </div>
                }

                @if (_failOrderId == order.OrderId)
                {
                    <div class="fail-form">
                        <label class="field__label" for="fail-reason-@order.OrderId">Reason</label>
                        <select id="fail-reason-@order.OrderId" class="field__input" value="@_failReason"
                                @onchange="OnFailReasonChanged">
                            @foreach (var (value, label) in FailureReasons.All)
                            {
                                <option value="@value">@label</option>
                            }
                        </select>

                        <textarea class="field__input fail-form__notes" rows="2"
                                  placeholder="Comment (optional)" @bind="_failNotes"></textarea>

                        <InputFile class="fail-form__file" accept="image/*" capture="environment"
                                   OnChange="OnPhotoSelected" />
                        @if (_failFile is not null)
                        {
                            <p class="fail-form__filename">Photo: @_failFile.Name</p>
                        }

                        @if (_failError is not null)
                        {
                            <p class="action-error">@_failError</p>
                        }

                        <div class="order-row__actions">
                            <button class="btn btn--sm btn--danger" disabled="@_busy"
                                    @onclick="() => SubmitFailAsync(order.OrderId)">
                                @(_busy ? "Sending…" : "Send")
                            </button>
                            <button class="btn btn--sm btn--ghost" disabled="@_busy" @onclick="CloseFailForm">
                                Cancel
                            </button>
                        </div>
                    </div>
                }
            </li>
        }
    </ul>

    @if (CanAct)
    {
        <button class="btn btn--ghost stop-card__skip" disabled="@_busy" @onclick="SkipAsync">
            Skip stop
        </button>
    }
    else if (Stop.Status == "Skipped" && RouteInProgress)
    {
        <button class="btn btn--primary stop-card__skip" disabled="@_busy" @onclick="ResumeAsync">
            Return to stop
        </button>
    }
</div>

@code {
    private const long MaxPhotoBytes = 8 * 1024 * 1024;
    private const string DefaultPhotoContentType = "image/jpeg";

    [Parameter, EditorRequired]
    public RouteStop Stop { get; set; } = default!;

    [Parameter, EditorRequired]
    public Guid RouteId { get; set; }

    [Parameter]
    public bool RouteInProgress { get; set; }

    [Parameter]
    public int TotalStops { get; set; }

    [Parameter]
    public bool IsCurrent { get; set; }

    [Parameter]
    public EventCallback OnChanged { get; set; }

    private bool _busy;
    private string? _error;

    private string PinClass => IsCurrent ? "pin-current" : StatusLabels.PinCss(Stop.Status);

    private string Eyebrow
    {
        get
        {
            if (IsCurrent)
                return "Current stop";

            return Stop.Status switch
            {
                "Completed" => "Delivered",
                "Failed" => "Not delivered",
                "Skipped" => "Skipped",
                "PartiallyCompleted" => "Partial",
                _ => "Upcoming stop"
            };
        }
    }

    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "?";

        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length == 1)
            return parts[0][..1].ToUpperInvariant();

        return (parts[0][..1] + parts[^1][..1]).ToUpperInvariant();
    }

    private Guid? _failOrderId;
    private string _failReason = FailureReasons.All[0].Value;
    private string? _failNotes;
    private IBrowserFile? _failFile;
    private string? _failError;

    private bool CanAct => RouteInProgress && Stop.Status == "InProgress";

    private static bool IsOrderClosed(string status) =>
        status is "Delivered" or "Failed" or "Cancelled";

    private static string OrderRowCss(string status) => status switch
    {
        "Delivered" => "order-row--done",
        "Failed" => "order-row--failed",
        _ => string.Empty
    };

    private void OnFailReasonChanged(ChangeEventArgs e) =>
        _failReason = e.Value?.ToString() ?? FailureReasons.All[0].Value;

    private void OpenFailForm(Guid orderId)
    {
        _failOrderId = orderId;
        _failReason = FailureReasons.All[0].Value;
        _failNotes = null;
        _failFile = null;
        _failError = null;
    }

    private void CloseFailForm()
    {
        _failOrderId = null;
        _failFile = null;
        _failError = null;
    }

    private void OnPhotoSelected(InputFileChangeEventArgs e) => _failFile = e.File;

    private async Task DeliverAsync(Guid orderId)
    {
        if (_busy)
            return;

        _busy = true;
        _error = null;

        try
        {
            var result = await RouteApi.DeliverOrderAsync(RouteId, Stop.Id, orderId);

            if (result.Success)
                await OnChanged.InvokeAsync();
            else
                _error = result.Error;
        }
        catch (HttpRequestException)
        {
            _error = "No server connection.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SubmitFailAsync(Guid orderId)
    {
        if (_busy)
            return;

        if (_failFile is not null && !Connectivity.IsOnline)
        {
            _failError = "Photo on failure is available online only. Submit without a photo or connect to the network.";
            return;
        }

        _busy = true;
        _failError = null;

        try
        {
            string? photoKey = null;

            if (_failFile is not null)
            {
                photoKey = await UploadPhotoAsync(_failFile);

                if (photoKey is null)
                {
                    _failError = "Failed to upload the photo.";
                    return;
                }
            }

            var position = await Geolocation.TryGetCurrentPositionAsync();

            var request = new FailDeliveryRequest(
                position?.Latitude ?? 0,
                position?.Longitude ?? 0,
                _failReason,
                string.IsNullOrWhiteSpace(_failNotes) ? null : _failNotes,
                photoKey);

            var result = await RouteApi.FailOrderAsync(RouteId, Stop.Id, orderId, request);

            if (result.Success)
            {
                CloseFailForm();
                await OnChanged.InvokeAsync();
            }
            else
            {
                _failError = result.Error;
            }
        }
        catch (HttpRequestException)
        {
            _failError = "No server connection.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task<string?> UploadPhotoAsync(IBrowserFile file)
    {
        var upload = await RouteApi.CreatePhotoUploadAsync();

        if (upload is null)
            return null;

        await using var stream = file.OpenReadStream(MaxPhotoBytes);
        using var buffer = new MemoryStream();
        await stream.CopyToAsync(buffer);

        var contentType = string.IsNullOrWhiteSpace(file.ContentType) ? DefaultPhotoContentType : file.ContentType;
        var uploaded = await RouteApi.UploadPhotoAsync(upload.UploadUrl, buffer.ToArray(), contentType);

        return uploaded ? upload.PhotoKey : null;
    }

    private Task SkipAsync() => RunAsync(() => RouteApi.SkipStopAsync(RouteId, Stop.Id));

    private Task ResumeAsync() => RunAsync(() => RouteApi.ResumeStopAsync(RouteId, Stop.Id));

    private async Task RunAsync(Func<Task<ApiResult>> action)
    {
        if (_busy)
            return;

        _busy = true;
        _error = null;

        try
        {
            var result = await action();

            if (result.Success)
                await OnChanged.InvokeAsync();
            else
                _error = result.Error;
        }
        catch (HttpRequestException)
        {
            _error = "No server connection.";
        }
        finally
        {
            _busy = false;
        }
    }
}
