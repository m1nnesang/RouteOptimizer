<Window x:Class="RouteOptimizer.Dispatcher.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:RouteOptimizer.Dispatcher.Wpf.VIewModels"
        xmlns:views="clr-namespace:RouteOptimizer.Dispatcher.Wpf.Views"
        mc:Ignorable="d"
        Title="Route Optimizer — Dispatcher" Height="600" Width="1000">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:OrdersViewModel}">
            <views:OrdersView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RoutesViewModel}">
            <views:RoutesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DriversViewModel}">
            <views:DriversView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VehiclesViewModel}">
            <views:VehiclesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WarehousesViewModel}">
            <views:WarehousesView/>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#2C3E50">
            <Button Content="Orders"
                    Command="{Binding ShowOrdersCommand}"
                    Margin="8,8,4,8" Padding="16,4" />
            <Button Content="Routes"
                    Command="{Binding ShowRoutesCommand}"
                    Margin="4,8,4,8" Padding="16,4" />
            <Button Content="Drivers"
                    Command="{Binding ShowDriversCommand}"
                    Margin="4,8,4,8" Padding="16,4" />
            <Button Content="Vehicles"
                    Command="{Binding ShowVehiclesCommand}"
                    Margin="4,8,4,8" Padding="16,4" />
            <Button Content="Warehouses"
                    Command="{Binding ShowWarehousesCommand}"
                    Margin="4,8,8,8" Padding="16,4" />
        </StackPanel>

        <ContentControl Grid.Row="1"
                        Content="{Binding CurrentViewModel}" />
    </Grid>
</Window>
