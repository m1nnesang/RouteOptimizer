<Window x:Class="RouteOptimizer.Dispatcher.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:RouteOptimizer.Dispatcher.Wpf.ViewModels"
        xmlns:views="clr-namespace:RouteOptimizer.Dispatcher.Wpf.Views"
        mc:Ignorable="d"
        Title="Route Optimizer — Dispatcher" Height="600" Width="1000">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:OrdersViewModel}">
            <views:OrdersView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RoutesViewModel}">
            <views:RoutesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DriversViewModel}">
            <views:DriversView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VehiclesViewModel}">
            <views:VehiclesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WarehousesViewModel}">
            <views:WarehousesView/>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource NavBarBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="20,0">
                    <Border Width="34" Height="34" CornerRadius="8"
                            Background="{StaticResource PrimaryBrush}"
                            VerticalAlignment="Center">
                        <TextBlock Text="R" Foreground="White" FontSize="18" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Route Optimizer" Foreground="White"
                               FontSize="16" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="0,0,12,0">
                    <Button Content="Orders" Style="{StaticResource NavButtonStyle}"
                            Command="{Binding ShowOrdersCommand}" Margin="2,10" />
                    <Button Content="Routes" Style="{StaticResource NavButtonStyle}"
                            Command="{Binding ShowRoutesCommand}" Margin="2,10" />
                    <Button Content="Drivers" Style="{StaticResource NavButtonStyle}"
                            Command="{Binding ShowDriversCommand}" Margin="2,10" />
                    <Button Content="Vehicles" Style="{StaticResource NavButtonStyle}"
                            Command="{Binding ShowVehiclesCommand}" Margin="2,10" />
                    <Button Content="Warehouses" Style="{StaticResource NavButtonStyle}"
                            Command="{Binding ShowWarehousesCommand}" Margin="2,10" />
                </StackPanel>
            </Grid>
        </Border>

        <ContentControl Grid.Row="1"
                        Content="{Binding CurrentViewModel}" />
    </Grid>
</Window>
