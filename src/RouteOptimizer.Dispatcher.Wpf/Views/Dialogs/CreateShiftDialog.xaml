<Window x:Class="RouteOptimizer.Dispatcher.Wpf.Views.Dialogs.CreateShiftDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assign Shift"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}"
        ResizeMode="NoResize">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Assign a shift to a driver"
                   Style="{StaticResource HeaderTextStyle}" FontSize="18" Margin="0,0,0,16"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Warehouse" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4"/>
            <ComboBox ItemsSource="{Binding Warehouses}"
                      SelectedItem="{Binding SelectedWarehouse}" Margin="0,0,0,12">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Text="Driver" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4"/>
            <ComboBox ItemsSource="{Binding Drivers}"
                      SelectedItem="{Binding SelectedDriver}" Margin="0,0,0,12">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Text="Vehicle" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4"/>
            <ComboBox ItemsSource="{Binding Vehicles}"
                      SelectedItem="{Binding SelectedVehicle}" Margin="0,0,0,12">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Type}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Text="Shift date" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4"/>
            <DatePicker SelectedDate="{Binding ShiftDate}" Width="160" HorizontalAlignment="Left"/>
        </StackPanel>

        <TextBlock Grid.Row="2"
                   Text="{Binding ErrorMessage}"
                   Foreground="{StaticResource DangerBrush}"
                   TextWrapping="Wrap"
                   Margin="0,12,0,0"
                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" Width="92" Margin="0,0,8,0"
                    Style="{StaticResource SecondaryButtonStyle}" Click="CancelButton_Click"/>
            <Button Content="Assign" Width="92"
                    IsEnabled="{Binding CanConfirm}" Click="ConfirmButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
