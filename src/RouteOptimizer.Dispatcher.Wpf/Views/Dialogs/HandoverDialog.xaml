<Window x:Class="RouteOptimizer.Dispatcher.Wpf.Views.Dialogs.HandoverDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Route Handover"
        Width="780" Height="600"
        MinWidth="600" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Loaded="Window_Loaded">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Route Handover"
                   Style="{StaticResource HeaderTextStyle}" FontSize="18" Margin="0,0,0,12"/>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="12" Padding="16,12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="How do you want to handle the remaining stops?"
                           Margin="0,0,0,10" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="Transfer to another driver"
                                 IsChecked="{Binding IsTransferAll, Mode=TwoWay}"
                                 GroupName="HandoverType"
                                 Margin="0,0,24,0" VerticalAlignment="Center"/>
                    <RadioButton Content="Distribute among drivers"
                                 IsChecked="{Binding IsDistribute, Mode=TwoWay}"
                                 GroupName="HandoverType"
                                 Margin="0,0,24,0" VerticalAlignment="Center"/>
                    <RadioButton Content="Return to order pool"
                                 IsChecked="{Binding IsReturnToPool, Mode=TwoWay}"
                                 GroupName="HandoverType"
                                 VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">

            <Grid Visibility="{Binding IsTransferAll, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Select the driver who will take over all remaining stops:"
                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock Text="Loading..." VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
                <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="1">
                    <DataGrid ItemsSource="{Binding AvailableShifts}"
                              SelectedItem="{Binding TargetShift}"
                              IsReadOnly="True"
                              BorderThickness="0"
                              Background="Transparent">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Driver"    Binding="{Binding DriverName}"    Width="170"/>
                            <DataGridTextColumn Header="Vehicle"   Binding="{Binding VehicleType}"   Width="130"/>
                            <DataGridTextColumn Header="Warehouse" Binding="{Binding WarehouseName}" Width="150"/>
                            <DataGridTextColumn Header="Status"    Binding="{Binding ShiftStatus}"   Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <Grid Visibility="{Binding IsDistribute, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Assign each pending stop to a driver:"
                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock Text="Loading..." VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
                <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="1">
                    <DataGrid ItemsSource="{Binding PendingStops}"
                              CanUserDeleteRows="False"
                              BorderThickness="0"
                              Background="Transparent">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="City"   Binding="{Binding City}"        Width="120" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Street" Binding="{Binding Street}"      Width="*"   IsReadOnly="True"/>
                            <DataGridTextColumn Header="Orders" Binding="{Binding OrdersCount}" Width="70"  IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="Assign to Driver" Width="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.AvailableShifts, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                  SelectedItem="{Binding SelectedShift, UpdateSourceTrigger=PropertyChanged}"
                                                  DisplayMemberPath="DriverName"
                                                  Margin="2,4"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <Border Visibility="{Binding IsReturnToPool, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="#FEE2E2" BorderBrush="#FCA5A5" BorderThickness="1"
                    CornerRadius="12" Padding="20,16"
                    VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Return all remaining stops to the order pool"
                               FontWeight="SemiBold" FontSize="14" Foreground="#991B1B" Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" LineHeight="20" Foreground="#7F1D1D">
                        All pending stops will be returned to the order pool and can be
                        reassigned to a future route. The driver completed stops remain
                        recorded in the delivery history.
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3"
                   Text="{Binding ErrorMessage}"
                   Foreground="{StaticResource DangerBrush}"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0"
                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Width="92" Margin="0,0,8,0"
                    Style="{StaticResource SecondaryButtonStyle}" Click="CancelButton_Click"/>
            <Button Content="Confirm Handover" Width="160"
                    IsEnabled="{Binding CanConfirm}"
                    Click="ConfirmButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
