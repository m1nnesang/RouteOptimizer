<Window x:Class="RouteOptimizer.Dispatcher.Wpf.Views.Dialogs.HandoverDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Route Handover"
        Width="780" Height="600"
        MinWidth="600" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Loaded="Window_Loaded">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Route Handover"
                   FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>

        <!-- Handover type selection -->
        <Border Grid.Row="1" Background="#F5F5F5" CornerRadius="4" Padding="12,10" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="How do you want to handle the remaining stops?"
                           Margin="0,0,0,8" FontWeight="Bold"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="Transfer to another driver"
                                 IsChecked="{Binding IsTransferAll, Mode=TwoWay}"
                                 GroupName="HandoverType"
                                 Margin="0,0,24,0" VerticalAlignment="Center"/>
                    <RadioButton Content="Distribute among drivers"
                                 IsChecked="{Binding IsDistribute, Mode=TwoWay}"
                                 GroupName="HandoverType"
                                 Margin="0,0,24,0" VerticalAlignment="Center"/>
                    <RadioButton Content="Return to order pool"
                                 IsChecked="{Binding IsReturnToPool, Mode=TwoWay}"
                                 GroupName="HandoverType"
                                 VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Content area: switches on handover type -->
        <Grid Grid.Row="2">

            <!-- Transfer All: pick one shift -->
            <Grid Visibility="{Binding IsTransferAll, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Select the driver who will take over all remaining stops:"
                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock Text="Loading..." VerticalAlignment="Center"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding AvailableShifts}"
                          SelectedItem="{Binding TargetShift}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Driver"    Binding="{Binding DriverName}"    Width="160"/>
                        <DataGridTextColumn Header="Vehicle"   Binding="{Binding VehicleType}"   Width="120"/>
                        <DataGridTextColumn Header="Warehouse" Binding="{Binding WarehouseName}" Width="140"/>
                        <DataGridTextColumn Header="Status"    Binding="{Binding ShiftStatus}"   Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- Distribute: assign each pending stop to a shift -->
            <Grid Visibility="{Binding IsDistribute, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Assign each pending stop to a driver:"
                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock Text="Loading..." VerticalAlignment="Center"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding PendingStops}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="City"   Binding="{Binding City}"        Width="110" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Street" Binding="{Binding Street}"      Width="*"   IsReadOnly="True"/>
                        <DataGridTextColumn Header="Orders" Binding="{Binding OrdersCount}" Width="60"  IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="Assign to Driver" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.AvailableShifts, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                              SelectedItem="{Binding SelectedShift, UpdateSourceTrigger=PropertyChanged}"
                                              DisplayMemberPath="DriverName"
                                              Margin="2,1"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- Return to Pool: confirmation message -->
            <Border Visibility="{Binding IsReturnToPool, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="#F8D7DA" CornerRadius="4" Padding="16,12"
                    VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Return all remaining stops to the order pool"
                               FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" LineHeight="20">
                        All pending stops will be returned to the order pool and can be
                        reassigned to a future route. The driver completed stops remain
                        recorded in the delivery history.
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Error -->
        <TextBlock Grid.Row="3"
                   Text="{Binding ErrorMessage}"
                   Foreground="Red"
                   Margin="0,6,0,0"
                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <!-- Footer -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel"           Width="90"  Padding="0,6" Margin="0,0,8,0" Click="CancelButton_Click"/>
            <Button Content="Confirm Handover" Width="140" Padding="0,6"
                    IsEnabled="{Binding CanConfirm}"
                    Click="ConfirmButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
