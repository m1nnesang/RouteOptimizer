<Window x:Class="RouteOptimizer.Dispatcher.Wpf.Views.Dialogs.AssignShiftDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assign Route to Shift"
        Width="720" Height="500"
        MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}"
        ResizeMode="CanResizeWithGrip"
        Loaded="Window_Loaded">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Select a shift to assign this route to"
                   Style="{StaticResource HeaderTextStyle}" FontSize="18" Margin="0,0,0,12"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
            <TextBlock Text="Date" Style="{StaticResource CaptionTextStyle}" Margin="0,0,8,0"/>
            <DatePicker SelectedDate="{Binding FilterDate}" Width="140" VerticalAlignment="Center"/>
            <Button Content="Refresh" Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding LoadShiftsCommand}" Margin="8,0,0,0"/>
            <TextBlock Text="Loading..." Margin="12,0,0,0" VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="1">
            <DataGrid ItemsSource="{Binding Shifts}"
                      SelectedItem="{Binding SelectedShift}"
                      IsReadOnly="True"
                      BorderThickness="0"
                      Background="Transparent">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Driver"    Binding="{Binding DriverName}"                       Width="170"/>
                    <DataGridTextColumn Header="Vehicle"   Binding="{Binding VehicleType}"                      Width="130"/>
                    <DataGridTextColumn Header="Warehouse" Binding="{Binding WarehouseName}"                    Width="150"/>
                    <DataGridTextColumn Header="Date"      Binding="{Binding ShiftDate, StringFormat=dd.MM.yyyy}" Width="100"/>
                    <DataGridTextColumn Header="Status"    Binding="{Binding ShiftStatus}"                      Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Grid.Row="3"
                   Text="{Binding ErrorMessage}"
                   Foreground="{StaticResource DangerBrush}"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0"
                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Width="92" Margin="0,0,8,0"
                    Style="{StaticResource SecondaryButtonStyle}" Click="CancelButton_Click"/>
            <Button Content="Assign" Width="92"
                    IsEnabled="{Binding HasSelectedShift}"
                    Click="ConfirmButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
