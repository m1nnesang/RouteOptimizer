<Window x:Class="RouteOptimizer.Dispatcher.Wpf.Views.Dialogs.VehicleEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}"
        ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}"
                   Style="{StaticResource HeaderTextStyle}" FontSize="18" Margin="0,0,0,16"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Type" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Type, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Max weight (kg)" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding MaxWeightKg, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Max volume (m³)" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding MaxVolumeM3, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="License category" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4"/>
            <ComboBox ItemsSource="{Binding LicenseCategories}"
                      SelectedItem="{Binding SelectedLicenseCategory}" Margin="0,0,0,12"/>

            <TextBlock Text="Allowed cargo types" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,6"/>
            <ItemsControl ItemsSource="{Binding CargoTypes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding Name}"
                                  IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                  Margin="0,3"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" Width="92" Margin="0,0,8,0"
                    Style="{StaticResource SecondaryButtonStyle}" Click="CancelButton_Click"/>
            <Button Content="Save" Width="92"
                    IsEnabled="{Binding CanConfirm}" Click="ConfirmButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
