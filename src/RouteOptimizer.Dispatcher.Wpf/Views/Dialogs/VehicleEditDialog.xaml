<Window x:Class="RouteOptimizer.Dispatcher.Wpf.Views.Dialogs.VehicleEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Type" Margin="0,0,0,2"/>
            <TextBox Text="{Binding Type, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Max weight (kg)" Margin="0,0,0,2"/>
                    <TextBox Text="{Binding MaxWeightKg, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Max volume (m³)" Margin="0,0,0,2"/>
                    <TextBox Text="{Binding MaxVolumeM3, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="License category" Margin="0,0,0,2"/>
            <ComboBox ItemsSource="{Binding LicenseCategories}"
                      SelectedItem="{Binding SelectedLicenseCategory}" Margin="0,0,0,10"/>

            <TextBlock Text="Allowed cargo types" Margin="0,0,0,4"/>
            <ItemsControl ItemsSource="{Binding CargoTypes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding Name}"
                                  IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                  Margin="0,2"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Width="90" Padding="0,6" Margin="0,0,8,0" Click="CancelButton_Click"/>
            <Button Content="Save" Width="90" Padding="0,6"
                    IsEnabled="{Binding CanConfirm}" Click="ConfirmButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
