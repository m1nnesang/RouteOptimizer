<Window x:Class="RouteOptimizer.Dispatcher.Wpf.Views.Dialogs.InsertUrgentOrderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Insert Urgent Order"
        Width="720" Height="520"
        MinWidth="560" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Loaded="Window_Loaded">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Insert an urgent order into the active route"
                   Style="{StaticResource HeaderTextStyle}" FontSize="18" Margin="0,0,0,10"/>

        <Border Grid.Row="1" Background="#352A16" BorderBrush="#4A3A1A" BorderThickness="1"
                CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource AmberBrush}">
                The order will be inserted at the optimal position in the route.
                The driver will receive a real-time notification via SignalR.
            </TextBlock>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="Refresh" Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding LoadOrdersCommand}"/>
            <TextBlock Text="Loading..." Margin="12,0,0,0" VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </StackPanel>

        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Padding="1">
            <DataGrid ItemsSource="{Binding AvailableOrders}"
                      SelectedItem="{Binding SelectedOrder}"
                      IsReadOnly="True"
                      BorderThickness="0"
                      Background="Transparent">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Type"        Binding="{Binding OrderType}"                 Width="90"/>
                    <DataGridTextColumn Header="Status"      Binding="{Binding Status}"                    Width="110"/>
                    <DataGridTextColumn Header="City"        Binding="{Binding City}"                      Width="120"/>
                    <DataGridTextColumn Header="Street"      Binding="{Binding Street}"                    Width="*"/>
                    <DataGridTextColumn Header="Cargo"       Binding="{Binding CargoType}"                 Width="110"/>
                    <DataGridTextColumn Header="Weight (kg)" Binding="{Binding Weight, StringFormat=F1}"   Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Grid.Row="4"
                   Text="{Binding ErrorMessage}"
                   Foreground="{StaticResource DangerBrush}"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0"
                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Width="92" Margin="0,0,8,0"
                    Style="{StaticResource SecondaryButtonStyle}" Click="CancelButton_Click"/>
            <Button Content="Insert" Width="92"
                    IsEnabled="{Binding HasSelectedOrder}"
                    Click="ConfirmButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
