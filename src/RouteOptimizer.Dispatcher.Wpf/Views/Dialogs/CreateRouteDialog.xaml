<Window x:Class="RouteOptimizer.Dispatcher.Wpf.Views.Dialogs.CreateRouteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Route"
        Width="820" Height="580"
        MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}"
        ResizeMode="CanResizeWithGrip"
        Loaded="Window_Loaded">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Select orders for the new route"
                       Style="{StaticResource HeaderTextStyle}" FontSize="18"/>
            <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="10" Padding="10,3" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextLinkBrush}" FontWeight="SemiBold">
                    <Run Text="{Binding SelectedCount, Mode=OneWay}"/>
                    <Run Text="selected"/>
                </TextBlock>
            </Border>
            <TextBlock Text="Loading..." Margin="16,0,0,0" VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
            <Button Content="Refresh" Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding LoadOrdersCommand}"/>
            <TextBlock Text="Route date" Style="{StaticResource CaptionTextStyle}"
                       VerticalAlignment="Center" Margin="24,0,8,0"/>
            <DatePicker SelectedDate="{Binding SelectedDate}" Width="140"
                        DisplayDateStart="{Binding MinDate}"/>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="1">
            <DataGrid ItemsSource="{Binding AvailableOrders}"
                      CanUserDeleteRows="False"
                      BorderThickness="0"
                      Background="Transparent">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header=""
                                            Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                            Width="40"/>
                    <DataGridTextColumn Header="Type"        Binding="{Binding OrderType}"                 Width="90"  IsReadOnly="True"/>
                    <DataGridTextColumn Header="Status"      Binding="{Binding Status}"                    Width="110" IsReadOnly="True"/>
                    <DataGridTextColumn Header="City"        Binding="{Binding City}"                      Width="120" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Street"      Binding="{Binding Street}"                    Width="*"   IsReadOnly="True"/>
                    <DataGridTextColumn Header="Cargo"       Binding="{Binding CargoType}"                 Width="110" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Weight (kg)" Binding="{Binding Weight, StringFormat=F1}"   Width="100" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Grid.Row="3"
                   Text="{Binding ErrorMessage}"
                   Foreground="{StaticResource DangerBrush}"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0"
                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Width="92" Margin="0,0,8,0"
                    Style="{StaticResource SecondaryButtonStyle}" Click="CancelButton_Click"/>
            <Button Content="Create Route" Width="130"
                    IsEnabled="{Binding HasSelectedOrders}"
                    Click="ConfirmButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
