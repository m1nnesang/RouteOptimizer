<Window x:Class="RouteOptimizer.Dispatcher.Wpf.Views.Dialogs.CreateRouteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Route"
        Width="820" Height="580"
        MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Loaded="Window_Loaded">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Select orders for the new route"
                       FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Margin="24,0,0,0" VerticalAlignment="Center">
                <Run FontWeight="Bold" Text="{Binding SelectedCount, Mode=OneWay}"/>
                <Run Text=" order(s) selected"/>
            </TextBlock>
            <TextBlock Text="Loading..." Margin="16,0,0,0" VerticalAlignment="Center"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </StackPanel>

        <!-- Toolbar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Refresh" Command="{Binding LoadOrdersCommand}" Padding="12,4"/>
        </StackPanel>

        <!-- Orders list -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding AvailableOrders}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header=""
                                        Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                        Width="36"/>
                <DataGridTextColumn Header="Type"        Binding="{Binding OrderType}"                 Width="80"  IsReadOnly="True"/>
                <DataGridTextColumn Header="Status"      Binding="{Binding Status}"                    Width="100" IsReadOnly="True"/>
                <DataGridTextColumn Header="City"        Binding="{Binding City}"                      Width="110" IsReadOnly="True"/>
                <DataGridTextColumn Header="Street"      Binding="{Binding Street}"                    Width="*"   IsReadOnly="True"/>
                <DataGridTextColumn Header="Cargo"       Binding="{Binding CargoType}"                 Width="100" IsReadOnly="True"/>
                <DataGridTextColumn Header="Weight (kg)" Binding="{Binding Weight, StringFormat=F1}"   Width="90"  IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Error -->
        <TextBlock Grid.Row="3"
                   Text="{Binding ErrorMessage}"
                   Foreground="Red"
                   Margin="0,6,0,0"
                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <!-- Footer -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel"       Width="90"  Padding="0,6" Margin="0,0,8,0" Click="CancelButton_Click"/>
            <Button Content="Create Route" Width="120" Padding="0,6"
                    IsEnabled="{Binding HasSelectedOrders}"
                    Click="ConfirmButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
