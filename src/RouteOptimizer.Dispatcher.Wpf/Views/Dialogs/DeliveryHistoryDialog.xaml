<Window x:Class="RouteOptimizer.Dispatcher.Wpf.Views.Dialogs.DeliveryHistoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:RouteOptimizer.Dispatcher.Wpf.Views"
        Title="Delivery proof &amp; history"
        Width="560" Height="640"
        MinWidth="420" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Delivery history" Style="{StaticResource HeaderTextStyle}" FontSize="18"/>
            <TextBlock Text="Attempts, failures and proof photos for this order"
                       Style="{StaticResource CaptionTextStyle}"/>
        </StackPanel>

        <views:DeliveryHistoryPanel Grid.Row="1"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Close" Width="92"
                    Style="{StaticResource SecondaryButtonStyle}" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
