<UserControl x:Class="RouteOptimizer.Dispatcher.Wpf.Views.RoutesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:RouteOptimizer.Dispatcher.Wpf.Views">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Border Width="4" Height="26" CornerRadius="2"
                        Background="{StaticResource PrimaryBrush}" Margin="0,0,12,0"/>
                <StackPanel>
                    <TextBlock Text="Routes" Style="{StaticResource HeaderTextStyle}"/>
                    <TextBlock Text="Plan and optimize delivery routes" Style="{StaticResource CaptionTextStyle}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
                <TextBox Width="180" VerticalAlignment="Center"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                         ToolTip="Search by status, driver, warehouse, date..."/>
                <TextBlock Text="Status" Style="{StaticResource CaptionTextStyle}" Margin="16,0,8,0"/>
                <ComboBox ItemsSource="{Binding StatusFilters}"
                          SelectedItem="{Binding SelectedStatusFilter}"
                          Width="150"/>
                <TextBlock Text="Date" Style="{StaticResource CaptionTextStyle}" Margin="24,0,8,0"/>
                <DatePicker SelectedDate="{Binding SelectedDate}" Width="140"/>
                <Button Content="✕" Width="28" Margin="4,0,0,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        ToolTip="Show all days"
                        Command="{Binding ClearDateFilterCommand}"
                        Visibility="{Binding HasDateFilter, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <TextBlock Text="Loading..." Margin="16,0,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="Refresh" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding LoadRoutesCommand}" Margin="0,0,8,0"/>
                <Button Content="+ Create route"
                        Command="{Binding CreateRouteCommand}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="1">
                <Grid>
                    <DataGrid ItemsSource="{Binding Routes}"
                              SelectedItem="{Binding SelectedRoute}"
                              IsReadOnly="True"
                              BorderThickness="0"
                              Background="Transparent">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="95"/>
                            <DataGridTemplateColumn Header="Status" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StatusChipStyle}"
                                                Background="{Binding Status, Converter={StaticResource StatusChipBgConverter}}">
                                            <TextBlock Text="{Binding Status}"
                                                       Style="{StaticResource StatusChipTextStyle}"
                                                       Foreground="{Binding Status, Converter={StaticResource StatusChipFgConverter}}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Stops" Binding="{Binding StopsCount}" Width="48"/>
                            <DataGridTextColumn Header="Driver" Binding="{Binding DriverName}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextLinkBrush}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="No routes yet. Create a route to get started."
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="16"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <TextBlock Text="Loading..." HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Border Style="{StaticResource CardBorderStyle}"
                        Visibility="{Binding NoRouteSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Select a route from the list"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="14"/>
                </Border>

                <Grid Visibility="{Binding HasSelectedRoute, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="16,12" Margin="0,0,0,12">
                        <WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,28,0">
                                <TextBlock Text="Status" Style="{StaticResource CaptionTextStyle}" Margin="0,0,6,0"/>
                                <Border Style="{StaticResource StatusChipStyle}"
                                        Background="{Binding SelectedRoute.Status, Converter={StaticResource StatusChipBgConverter}}">
                                    <TextBlock Text="{Binding SelectedRoute.Status}"
                                               Style="{StaticResource StatusChipTextStyle}"
                                               Foreground="{Binding SelectedRoute.Status, Converter={StaticResource StatusChipFgConverter}}"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,28,0">
                                <TextBlock Text="Date" Style="{StaticResource CaptionTextStyle}" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding SelectedRoute.Date, StringFormat=dd.MM.yyyy}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,28,0">
                                <TextBlock Text="Driver" Style="{StaticResource CaptionTextStyle}" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding SelectedRoute.DriverName}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Warehouse" Style="{StaticResource CaptionTextStyle}" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding SelectedRoute.WarehouseName}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </WrapPanel>
                    </Border>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="Optimize"
                                Command="{Binding OptimizeCommand}" Margin="0,0,8,0"/>
                        <Button Content="Assign shift" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding AssignShiftCommand}" Margin="0,0,8,0"/>
                        <Button Content="Urgent order" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding InsertUrgentOrderCommand}" Margin="0,0,8,0"/>
                        <Button Content="Handover" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding HandoverCommand}" Margin="0,0,8,0"/>
                        <Button Content="Interrupt" Style="{StaticResource AmberButtonStyle}"
                                Command="{Binding InterruptRouteCommand}" Margin="0,0,8,0"/>
                        <Button Content="Cancel route" Style="{StaticResource DangerButtonStyle}"
                                Command="{Binding CancelRouteCommand}"/>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="380"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="2*" MinWidth="300"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="1">
                            <DataGrid ItemsSource="{Binding SelectedRouteStops}"
                                      IsReadOnly="True"
                                      BorderThickness="0"
                                      Background="Transparent"
                                      RowDetailsVisibilityMode="VisibleWhenSelected"
                                      PreviewMouseLeftButtonDown="StopsGrid_PreviewMouseLeftButtonDown">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="#" Width="40">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Width="22" Height="22" CornerRadius="6"
                                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                                        Background="{Binding Status, Converter={StaticResource StatusChipBgConverter}}">
                                                    <TextBlock Text="{Binding Position}" FontSize="11" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{Binding Status, Converter={StaticResource StatusChipFgConverter}}"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Status" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource StatusChipStyle}"
                                                        Background="{Binding Status, Converter={StaticResource StatusChipBgConverter}}">
                                                    <TextBlock Text="{Binding Status}"
                                                               Style="{StaticResource StatusChipTextStyle}"
                                                               Foreground="{Binding Status, Converter={StaticResource StatusChipFgConverter}}"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="City" Binding="{Binding City}" Width="100"/>
                                    <DataGridTextColumn Header="Street" Binding="{Binding Street}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextLinkBrush}"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Header="Orders" Width="70">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding OrdersCount}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="▾" Margin="6,0,0,0" Foreground="{StaticResource TextLinkBrush}"
                                                               VerticalAlignment="Center"
                                                               Visibility="{Binding HasMultipleOrders, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                                <DataGrid.RowDetailsTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BgRowAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                                                Padding="48,8,12,8">
                                            <ItemsControl ItemsSource="{Binding Orders}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="90"/>
                                                                <ColumnDefinition Width="70"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Type}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding ApartmentDisplay}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Recipient}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding Phone}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                                                            <Button Grid.Column="4" Content="Proof"
                                                                    Padding="8,1" FontSize="11"
                                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                                    ToolTip="View delivery attempts and proof photos"
                                                                    Command="{Binding DataContext.ViewOrderProofCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding OrderId}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </DataTemplate>
                                </DataGrid.RowDetailsTemplate>
                            </DataGrid>
                        </Border>

                        <Border Grid.Column="2"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <views:RouteMapView Stops="{Binding SelectedRouteStops}"
                                                DepotLat="{Binding DepotLat}" DepotLng="{Binding DepotLng}"
                                                DriverLat="{Binding DriverLat}" DriverLng="{Binding DriverLng}"/>
                        </Border>
                    </Grid>

                    <Border Grid.Row="3"
                            Margin="0,12,0,0" Padding="16,12"
                            Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1" CornerRadius="12"
                            Visibility="{Binding HasOptimizationResult, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Optimization result"
                                       FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding OptimizationComparisons}"
                                      IsReadOnly="True"
                                      BorderThickness="0"
                                      Background="Transparent"
                                      MaxHeight="120">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Algorithm" Binding="{Binding AlgorithmName}" Width="180"/>
                                    <DataGridTextColumn Header="Duration (s)" Binding="{Binding TotalDurationSeconds, StringFormat=F0}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="4"
                               Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
