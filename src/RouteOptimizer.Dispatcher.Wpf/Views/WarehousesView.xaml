<UserControl x:Class="RouteOptimizer.Dispatcher.Wpf.Views.WarehousesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Border Width="4" Height="26" CornerRadius="2"
                        Background="{StaticResource PrimaryBrush}" Margin="0,0,12,0"/>
                <StackPanel>
                    <TextBlock Text="Warehouses" Style="{StaticResource HeaderTextStyle}"/>
                    <TextBlock Text="Depots and pickup locations" Style="{StaticResource CaptionTextStyle}"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Grid.Column="1" Text="Loading..." Margin="16,0,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       VerticalAlignment="Center" HorizontalAlignment="Left"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <Button Grid.Column="2" Content="+ Create"
                    Command="{Binding CreateWarehouseCommand}"/>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="Refresh" Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding LoadWarehousesCommand}" Margin="0,0,8,0"/>
            <Button Content="Edit" Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding EditWarehouseCommand}"
                    IsEnabled="{Binding HasSelectedWarehouse}" Margin="0,0,8,0"/>
            <Button Content="Delete" Style="{StaticResource DangerButtonStyle}"
                    Command="{Binding DeleteWarehouseCommand}"
                    IsEnabled="{Binding HasSelectedWarehouse}"/>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="1">
            <DataGrid ItemsSource="{Binding Warehouses}"
                      SelectedItem="{Binding SelectedWarehouse}"
                      IsReadOnly="True"
                      BorderThickness="0"
                      Background="Transparent">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="220"/>
                    <DataGridTextColumn Header="City" Binding="{Binding City}" Width="150"/>
                    <DataGridTextColumn Header="Street" Binding="{Binding Street}" Width="*"/>
                    <DataGridTextColumn Header="Lat" Binding="{Binding Latitude, StringFormat=F5}" Width="100"/>
                    <DataGridTextColumn Header="Lon" Binding="{Binding Longitude, StringFormat=F5}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Grid.Row="3"
                   Text="{Binding ErrorMessage}"
                   Foreground="{StaticResource DangerBrush}"
                   TextWrapping="Wrap"
                   Margin="0,12,0,0"
                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"/>
    </Grid>
</UserControl>
