<UserControl x:Class="RouteOptimizer.Dispatcher.Wpf.Views.DriversView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Border Width="4" Height="26" CornerRadius="2"
                        Background="{StaticResource PrimaryBrush}" Margin="0,0,12,0"/>
                <StackPanel>
                    <TextBlock Text="Shifts" Style="{StaticResource HeaderTextStyle}"/>
                    <TextBlock Text="Driver shifts and status" Style="{StaticResource CaptionTextStyle}"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Grid.Column="1" Text="Loading..." Margin="16,0,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       VerticalAlignment="Center" HorizontalAlignment="Left"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
            <Button Content="Assign shift" Command="{Binding CreateShiftCommand}" Margin="0,0,12,0"/>
            <Button Content="Refresh" Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding LoadShiftsCommand}" Margin="0,0,12,0"/>
            <TextBlock Text="Date" Style="{StaticResource CaptionTextStyle}" Margin="0,0,8,0"/>
            <DatePicker SelectedDate="{Binding FilterDate}" Width="140" VerticalAlignment="Center"/>
            <Button Content="Clear filter" Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding ClearDateFilterCommand}" Margin="8,0,0,0"/>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="1">
            <Grid>
            <DataGrid ItemsSource="{Binding Shifts}"
                      SelectedItem="{Binding SelectedShift}"
                      IsReadOnly="True"
                      BorderThickness="0"
                      Background="Transparent">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Driver" Binding="{Binding DriverName}" Width="180"/>
                    <DataGridTextColumn Header="Vehicle" Binding="{Binding VehicleType}" Width="130"/>
                    <DataGridTextColumn Header="Warehouse" Binding="{Binding WarehouseName}" Width="150"/>
                    <DataGridTextColumn Header="Date" Binding="{Binding ShiftDate, StringFormat=dd.MM.yyyy}" Width="100"/>
                    <DataGridTextColumn Header="Started" Binding="{Binding StartedAt, StringFormat=HH:mm}" Width="80"/>
                    <DataGridTextColumn Header="Ended" Binding="{Binding EndedAt, StringFormat=HH:mm}" Width="80"/>
                    <DataGridTemplateColumn Header="Status" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource StatusChipStyle}"
                                        Background="{Binding ShiftStatus, Converter={StaticResource StatusChipBgConverter}}">
                                    <TextBlock Text="{Binding ShiftStatus}"
                                               Style="{StaticResource StatusChipTextStyle}"
                                               Foreground="{Binding ShiftStatus, Converter={StaticResource StatusChipFgConverter}}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
                <TextBlock Text="No shifts for the selected period."
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="16"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3"
                   Text="{Binding ErrorMessage}"
                   Foreground="{StaticResource DangerBrush}"
                   TextWrapping="Wrap"
                   Margin="0,12,0,0"
                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"/>
    </Grid>
</UserControl>
