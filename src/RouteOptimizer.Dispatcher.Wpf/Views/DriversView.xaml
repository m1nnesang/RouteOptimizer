<UserControl x:Class="RouteOptimizer.Dispatcher.Wpf.Views.DriversView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Shifts" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Content="Refresh"
                    Command="{Binding LoadShiftsCommand}"
                    Margin="16,0,0,0" Padding="12,4"/>
            <DatePicker SelectedDate="{Binding FilterDate}"
                        Margin="16,0,0,0" VerticalAlignment="Center" Width="130"/>
            <Button Content="Clear filter"
                    Command="{Binding ClearDateFilterCommand}"
                    Margin="8,0,0,0" Padding="12,4"/>
            <TextBlock Text="Loading..." Margin="12,0,0,0" VerticalAlignment="Center"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </StackPanel>

        <!-- Shifts table -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Shifts}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectedItem="{Binding SelectedShift}"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Driver" Binding="{Binding DriverName}" Width="160"/>
                <DataGridTextColumn Header="Vehicle" Binding="{Binding VehicleType}" Width="120"/>
                <DataGridTextColumn Header="Warehouse" Binding="{Binding WarehouseName}" Width="140"/>
                <DataGridTextColumn Header="Date" Binding="{Binding ShiftDate, StringFormat=dd.MM.yyyy}" Width="90"/>
                <DataGridTextColumn Header="Started" Binding="{Binding StartedAt, StringFormat=HH:mm}" Width="70"/>
                <DataGridTextColumn Header="Ended" Binding="{Binding EndedAt, StringFormat=HH:mm}" Width="70"/>
                <DataGridTextColumn Header="Status" Binding="{Binding ShiftStatus}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Error -->
        <TextBlock Grid.Row="2"
                   Text="{Binding ErrorMessage}"
                   Foreground="Red"
                   Margin="0,8,0,0"
                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"/>
    </Grid>
</UserControl>
