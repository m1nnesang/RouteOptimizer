<Window x:Class="RouteOptimizer.Dispatcher.Wpf.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Route Optimizer"
        Width="480" Height="620"
        MinWidth="480" MinHeight="620"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.Background>
            <RadialGradientBrush GradientOrigin="0.5,0.35" Center="0.5,0.35" RadiusX="0.9" RadiusY="0.8">
                <GradientStop Color="#16213D" Offset="0"/>
                <GradientStop Color="#0F1626" Offset="0.6"/>
                <GradientStop Color="#0A0E1A" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>

        <Border Width="400"
                Background="{StaticResource BgPanelBrush}"
                BorderBrush="#232C44" BorderThickness="1"
                CornerRadius="20" Padding="32,36"
                VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="48" ShadowDepth="0" Opacity="0.55"/>
            </Border.Effect>
            <StackPanel>
                <Border Width="56" Height="56" CornerRadius="16"
                        Background="{StaticResource PrimaryBrush}"
                        HorizontalAlignment="Center" Margin="0,0,0,18">
                    <Border.Effect>
                        <DropShadowEffect Color="#4C84FF" BlurRadius="28" ShadowDepth="0" Opacity="0.6"/>
                    </Border.Effect>
                    <TextBlock Text="R" Foreground="White" FontSize="30" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="Route Optimizer"
                           Style="{StaticResource HeaderTextStyle}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Sign in to your dispatcher account"
                           Style="{StaticResource CaptionTextStyle}"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,26"/>

                <StackPanel Visibility="{Binding IsLoginMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Email" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             Height="40" Margin="0,0,0,16"/>

                    <TextBlock Text="Password" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="PasswordBox" Height="40" Margin="0,0,0,24"/>

                    <Button Content="Sign in"
                            Click="LoginButton_Click"
                            IsEnabled="{Binding IsNotLoading}"
                            Height="44" FontSize="15"
                            HorizontalAlignment="Stretch">
                        <Button.Effect>
                            <DropShadowEffect Color="#4C84FF" BlurRadius="22" ShadowDepth="0" Opacity="0.45"/>
                        </Button.Effect>
                    </Button>

                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               Margin="0,14,0,0"/>

                    <Button Content="Forgot password?"
                            Command="{Binding ShowResetCommand}"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource TextLinkBrush}"
                            HorizontalAlignment="Center" Margin="0,14,0,0"/>
                </StackPanel>

                <StackPanel Visibility="{Binding IsResetMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Request a reset link by email"
                               Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding ResetEmail, UpdateSourceTrigger=PropertyChanged}"
                             Height="40" Margin="0,0,0,10"/>
                    <Button Content="Send reset link"
                            Command="{Binding RequestResetCommand}"
                            Height="42"
                            HorizontalAlignment="Stretch" Margin="0,0,0,20"/>

                    <TextBlock Text="Have a reset token?"
                               Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding ResetToken, UpdateSourceTrigger=PropertyChanged}"
                             Height="40" Margin="0,0,0,10"/>
                    <TextBlock Text="New password" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding ResetNewPassword, UpdateSourceTrigger=PropertyChanged}"
                             Height="40" Margin="0,0,0,14"/>
                    <Button Content="Set new password"
                            Command="{Binding ResetPasswordCommand}"
                            Height="42"
                            HorizontalAlignment="Stretch"/>

                    <TextBlock Text="{Binding ResetMessage}"
                               Foreground="{StaticResource TextLinkBrush}"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               Margin="0,14,0,0"/>

                    <Button Content="Back to sign in"
                            Command="{Binding BackToLoginCommand}"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource TextLinkBrush}"
                            HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
