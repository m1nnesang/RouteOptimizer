<Window x:Class="RouteOptimizer.Dispatcher.Wpf.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Route Optimizer"
        Width="440" Height="560"
        MinWidth="440" MinHeight="560"
        WindowStartupLocation="CenterScreen">

    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Border Style="{StaticResource CardBorderStyle}"
                Width="340"
                VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="#1E293B" BlurRadius="24" ShadowDepth="0" Opacity="0.12"/>
            </Border.Effect>
            <StackPanel>
                <Border Width="48" Height="48" CornerRadius="12"
                        Background="{StaticResource PrimaryBrush}"
                        HorizontalAlignment="Center" Margin="0,0,0,16">
                    <TextBlock Text="R" Foreground="White" FontSize="26" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="Route Optimizer"
                           Style="{StaticResource HeaderTextStyle}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Sign in to your dispatcher account"
                           Style="{StaticResource CaptionTextStyle}"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,24"/>

                <TextBlock Text="Email" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,14"/>

                <TextBlock Text="Password" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4"/>
                <PasswordBox x:Name="PasswordBox" Margin="0,0,0,20"/>

                <Button Content="Sign in"
                        Click="LoginButton_Click"
                        IsEnabled="{Binding IsNotLoading}"
                        HorizontalAlignment="Stretch"/>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
